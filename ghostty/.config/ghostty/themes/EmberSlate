# ------------------------- Theme / base colors -------------------------

# Main background color. Dark and soft enough to reduce eye strain.
background = #16191D

# Default foreground text color. Bright enough for readability without being harsh.
foreground = #edf2f7

# Cursor color. A warm accent to make the cursor easy to locate.
cursor-color = #ffd166

# Background color used when text is selected.
selection-background = #2d4f73

# Text color inside the selected region. Off-white helps maintain readability.
selection-foreground = #f5f7fa

# Disables Ghostty's shell integration cursor feature for a cleaner minimal look.
shell-integration-features = no-cursor
 
# ---------------------------- Color palette ----------------------------

# These colors define the 16 standard terminal colors used by tools, editors,
# and shell output. The palette is tuned to feel balanced, vibrant, and easy on the eyes.

