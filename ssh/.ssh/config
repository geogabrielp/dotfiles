# ~/.ssh/config - OpenSSH client configuration

# Machine-local overrides (NEVER commit to version control):
# auto-included at the very top, before any Host blocks, so per-machine
# entries apply to all hosts. e.g. OrbStack's line
#   Include ~/.orbstack/ssh/config
# belongs in ~/.ssh/config_local (same pattern as ~/.gitconfig_local).
Include ~/.ssh/config_local

# GitHub - use SSH by default for git operations
Host github.com
    HostName github.com            # canonical hostname
    User git                       # GitHub requires the git user
    IdentityFile ~/.ssh/id_ed25519 # your key (create with: ssh-keygen -t ed25519)
    IdentitiesOnly yes             # use only this identity file (no guessing)
    AddKeysToAgent yes             # load the key into the agent once per session
    # UseKeychain yes                # macOS ONLY: store passphrase in Keychain

